    <!-- FAQ Section (Reuse from contact page essentially) -->
    <section class="faq-section bg-light" style="padding: 6rem 0;">
        <div class="container">
            <h2 class="faq-title text-center mb-5 font-bold" style="font-size:2.25rem;">Frequently Asked Questions</h2>
            <div class="faq-container mx-auto" style="max-width:800px;">
                <details class="faq-item bg-white rounded shadow-sm mb-3" open>
                    <summary style="padding:1.5rem; font-weight:600; cursor:pointer; display:flex; justify-content:space-between;">What services does your travel agency provide?</summary>
                    <div class="faq-answer px-4 pb-4 text-muted" style="line-height:1.6;">
                        <p>We provide comprehensive travel consulting, custom itinerary planning, and guided tours across Finland and the Nordics. From flights to accommodations and exclusive local experiences, we handle everything.</p>
                    </div>
                </details>
                <details class="faq-item bg-white rounded shadow-sm mb-3">
                    <summary style="padding:1.5rem; font-weight:600; cursor:pointer; display:flex; justify-content:space-between;">How do I book a tour package?</summary>
                    <div class="faq-answer px-4 pb-4 text-muted" style="line-height:1.6;">
                        <p>You can book directly through our website by selecting your desired tour and clicking 'View Tour' -> 'Book Now'. Alternatively, contact our support team for assistance.</p>
                    </div>
                </details>
                <details class="faq-item bg-white rounded shadow-sm mb-3">
                    <summary style="padding:1.5rem; font-weight:600; cursor:pointer; display:flex; justify-content:space-between;">Can I customize my travel package?</summary>
                    <div class="faq-answer px-4 pb-4 text-muted" style="line-height:1.6;">
                        <p>Absolutely! We specialize in tailor-made itineraries to suit your specific interests and schedule.</p>
                    </div>
                </details>
                <details class="faq-item bg-white rounded shadow-sm mb-3">
                    <summary style="padding:1.5rem; font-weight:600; cursor:pointer; display:flex; justify-content:space-between;">What is your refund policy on tours?</summary>
                    <div class="faq-answer px-4 pb-4 text-muted" style="line-height:1.6;">
                        <p>We offer free cancellation up to 24-48 hours before the tour start time. Please refer to our terms and conditions for full details.</p>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-blue-section bg-primary text-white text-center" style="padding: 6rem 0;">
        <div class="container">
            <p class="text-uppercase tracking-wide mb-2" style="opacity: 0.9; font-size:0.9rem; letter-spacing:2px;">10,000+ Happy Customers</p>
            <h2 class="section-title text-white mb-5 font-bold" style="font-size:2.5rem;">What the People Say</h2>
            
            <div class="reviews-grid d-grid gap-4 text-left" style="grid-template-columns: repeat(4, 1fr);">
                <div class="review-card bg-white text-dark rounded-4 p-4 shadow-sm">
                    <h4 class="review-title font-bold mb-3" style="font-size:1.1rem;">"Outstanding!"</h4>
                    <p class="review-text text-muted mb-4" style="line-height:1.5; font-size:0.95rem;">The Northern Lights tour was absolutely breathtaking. The guides were professional and the hot berry juice was a lovely touch!</p>
                    <div class="review-author d-flex align-items-center gap-3 border-top pt-3">
                        <img src="images/team/travelers-img2.png" alt="Sarah D." class="author-img rounded-circle" style="width:40px; height:40px;">
                        <div class="author-info">
                            <h6 class="author-name mb-0 font-semibold" style="font-size:0.95rem;">Sarah D.</h6>
                            <div class="author-rating text-warning" style="font-size:0.8rem;"><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i></div>
                        </div>
                    </div>
                </div>
                <div class="review-card bg-white text-dark rounded-4 p-4 shadow-sm">
                    <h4 class="review-title font-bold mb-3" style="font-size:1.1rem;">"Epic Adventure"</h4>
                    <p class="review-text text-muted mb-4" style="line-height:1.5; font-size:0.95rem;">The husky sledding in Levi is something my family will never forget. Everything was arranged perfectly from start to finish.</p>
                    <div class="review-author d-flex align-items-center gap-3 border-top pt-3">
                        <img src="images/team/testimonial-author-img4.png" alt="James L." class="author-img rounded-circle" style="width:40px; height:40px;">
                        <div class="author-info">
                            <h6 class="author-name mb-0 font-semibold" style="font-size:0.95rem;">James L.</h6>
