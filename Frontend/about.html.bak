a-dest-item"><img src="https://loremflickr.com/150/150/finland,lake/all?random=52" alt="Lakeland"><span>Lakeland</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/skiing,snow/all?random=53" alt="Winter Sports"><span>Winter Sports</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/nature,travel/all?random=10" alt="City Breaks"><span>City Breaks</span></a>                             </div>                         </div>                         <div class="mega-promo" style="background-image: url('https://loremflickr.com/400/600/finland,husky/all?random=60');">                             <div class="mega-promo-overlay"></div>                             <div class="mega-promo-content">                                 <h3 class="promo-sale" style="font-weight: 600; margin-bottom: 0;">15% OFF</h3>                                 <p class="promo-desc" style="font-size: 1.1rem; margin-bottom: 1.5rem;">Winter<br>Packages</p>                                 <a href="#" class="btn btn-primary">Book Now</a>                             </div>                         </div>                     </div>                 </div>                 <a href="transport.html" class="nav-link">Transport</a>
