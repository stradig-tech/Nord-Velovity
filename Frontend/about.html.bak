    <!-- About Hero Section -->
    <section class="about-hero" style="background-image: url('images/hero/al2-scaled.jpg');">
        <div class="about-hero-overlay"></div>
        <div class="about-hero-content text-center">
            <h1 class="about-hero-title">About Company</h1>
            <p class="about-hero-breadcrumb"><a href="index.html">Home</a> <i class="ph-bold ph-caret-right"></i> About Us</p>
        </div>
    </section>

    <!-- Intro Section -->
    <section class="about-intro-section text-center">
        <div class="container">

            <h2 class="intro-title text-primary" style="font-size:2rem; font-weight:700;"><span class="text-dark">Nord Velocity,</span> Trusted Travel Partner!</h2>
            <p class="intro-subtitle mx-auto text-muted mt-3" style="max-width:600px; line-height:1.6;">We are an independent travel agency dedicated to arranging tailored travel experiences across Finland and the Nordics.</p>
            
            <div class="intro-features-grid mt-5">
                <div class="feature-item">
                    <i class="ph-light ph-snowflake text-primary" style="font-size: 3.5rem;"></i>
                    <h4 class="mt-3 font-semibold">Northern Lights Tours</h4>
                    <p class="text-muted mt-2" style="font-size:0.9rem;">Exclusive aurora hunting experiences.</p>
                </div>
                <div class="feature-item">
                    <i class="ph-light ph-tree-evergreen text-primary" style="font-size: 3.5rem;"></i>
                    <h4 class="mt-3 font-semibold">Lapland Safaris</h4>
                    <p class="text-muted mt-2" style="font-size:0.9rem;">Husky and reindeer sledding adventures.</p>
                </div>
                <div class="feature-item">
                    <i class="ph-light ph-house-line text-primary" style="font-size: 3.5rem;"></i>
                    <h4 class="mt-3 font-semibold">Arctic Retreats</h4>
                    <p class="text-muted mt-2" style="font-size:0.9rem;">Premium glass igloos and ice hotels.</p>
                </div>
            </div>

            <div class="trustpilot-badge d-inline-flex align-items-center mt-5" style="gap:0.5rem; font-size:0.9rem;">
                <i class="ph-fill ph-star text-green-500" style="color: #22c55e;"></i> Trustpilot <strong>4.9/5.0</strong> based on 10,000+ reviews
            </div>
        </div>
    </section>

    <!-- Mission Section -->
    <section class="about-mission-section" style="padding: 6rem 0;">
        <div class="container">
            <div class="mission-grid">
                <div class="mission-text-content">
                    <h2 class="mission-title" style="font-size:2.5rem; font-weight:700; margin-bottom:1.5rem; line-height:1.2;">We're Top Travel Agency in the Nordics.</h2>
                    <p class="text-muted mb-4" style="line-height:1.6;">Discover the magic of the Arctic with the experts. We offer unparalleled experiences across the breathtaking landscapes of Finland.</p>
                    
                    <h4 class="font-bold mb-2">Our Mission</h4>
                    <p class="text-muted mb-4" style="line-height:1.6;">To provide authentic, unforgettable Nordic adventures while promoting sustainable tourism and respecting local traditions.</p>
                    
                    <h4 class="font-bold mb-2">Our Vision</h4>
                    <p class="text-muted mb-4" style="line-height:1.6;">To be the global benchmark for Arctic travel, ensuring every guest leaves with a deep appreciation for the North.</p>

                    <div class="signature-block mt-4 d-flex align-items-center gap-3">
                        <img src="https://loremflickr.com/100/100/signature/all?random=1" alt="Signature" style="height:40px; mix-blend-mode: multiply;">
                        <div>
                            <p class="font-bold mb-0">Nord Velocity</p>
                            <p class="text-muted" style="font-size: 0.8rem; margin:0;">Founder & CEO</p>
                        </div>
                    </div>
                </div>
                <div class="mission-images-wrapper relative">
                    <div class="image-stack relative">
                        <img src="images/offers/Day-Trip-to-Santa-Village7-550x358.jpg" alt="Mission 1" class="img-top rounded-4 shadow-lg">
                        <img src="images/citys/15-Kilometers-Self-Driving-Husky-Tour-in-Levi1-2-550x358.jpg" alt="Mission 2" class="img-bottom rounded-4 shadow-lg">
                        <div class="floating-badge bg-primary text-white text-center rounded-circle shadow-lg d-flex flex-column justify-content-center align-items-center" style="width:120px; height:120px;">
                            <span class="d-block font-bold" style="font-size: 1.8rem; line-height:1;">15+</span>
                            <span style="font-size: 0.75rem; line-height:1.2;">Years of<br>Experience</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Leadership Section -->
    <section class="leadership-section bg-light text-center" style="padding: 6rem 0;">
        <div class="container">
            <h2 class="section-title mb-3">Our Leadership</h2>
            <p class="text-muted mx-auto mb-5" style="max-width: 600px; line-height:1.6;">Meet the dedicated professionals who guide our vision and ensure your Nordic journey is flawless.</p>
            
            <div class="leadership-grid d-grid gap-4" style="grid-template-columns: repeat(4, 1fr);">
                <div class="team-member">
                    <img src="images/team/travelers-img1.png" alt="Michael Williams" class="team-img rounded-circle shadow-sm mb-3" style="width:150px; height:150px; object-fit:cover;">
                    <h4 class="team-name font-semibold" style="font-size:1.1rem;">Michael Williams</h4>
                    <p class="team-role text-muted" style="font-size:0.9rem;">CEO & Founder</p>
                </div>
                <div class="team-member">
                    <img src="images/team/testimonial-author-img4.png" alt="Alexander Johnson" class="team-img rounded-circle shadow-sm mb-3" style="width:150px; height:150px; object-fit:cover;">
                    <h4 class="team-name font-semibold" style="font-size:1.1rem;">Alexander Johnson</h4>
                    <p class="team-role text-muted" style="font-size:0.9rem;">Head of Operations</p>
                </div>
                <div class="team-member">
                    <img src="images/team/travelers-img2.png" alt="Sarah Connor" class="team-img rounded-circle shadow-sm mb-3" style="width:150px; height:150px; object-fit:cover;">
                    <h4 class="team-name font-semibold" style="font-size:1.1rem;">Sarah Connor</h4>
                    <p class="team-role text-muted" style="font-size:0.9rem;">Lead Travel Guide</p>
                </div>
                <div class="team-member">
                    <img src="images/team/travel-partner-img2.png" alt="Matthew Henry" class="team-img rounded-circle shadow-sm mb-3" style="width:150px; height:150px; object-fit:cover;">
                    <h4 class="team-name font-semibold" style="font-size:1.1rem;">Matthew Henry</h4>
                    <p class="team-role text-muted" style="font-size:0.9rem;">Customer Relations</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Tags/Destinations Section -->
    <section class="tags-section relative" style="background-image: url('images/hero/al2-scaled.jpg'); background-size: cover; background-position: center; background-attachment: fixed; padding:8rem 0;">
        <div class="tags-overlay absolute inset-0" style="background-color:rgba(0,0,0,0.3); position:absolute; top:0;left:0;right:0;bottom:0;"></div>
        <div class="container relative z-10" style="position:relative; z-index:2;">
            <div class="tags-card text-center bg-white rounded-4 shadow-lg mx-auto" style="max-width:900px; padding:4rem;">
                <h2 class="tags-title font-bold mb-4" style="font-size:2rem;">345+ Tours Awaiting For You</h2>
