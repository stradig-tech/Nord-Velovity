    <!-- Blog Grid Section -->
    <section class="tips-section" style="padding: 5rem 0;">
        <div class="tips-container">
            <div class="tips-grid">
                <!-- Tip 1 -->
                <div class="tip-card">
                    <div class="tip-img-box">
                        <img src="images/citys/Pyha_Sunrise-550x358.jpg" alt="Pyhä Sunrise" class="tip-img">
                        <div class="tip-badge"><i class="ph-bold ph-map-pin"></i> Pyhä, Lapland</div>
                    </div>
                    <div class="tip-body">
                        <h4 class="tip-title">Experiencing the Magic of a Pyhä Sunrise in Winter.</h4>
                        <p class="tip-desc">Discover the serene beauty of Pyhä-Luosto National Park as the sun breaks over the snow-covered fells.</p>
                        <a href="#" class="tip-link">Read More <i class="ph-bold ph-caret-right"></i></a>
                    </div>
                </div>

                <!-- Tip 2 -->
                <div class="tip-card">
                    <div class="tip-img-box">
                        <img src="images/citys/Northern-Lights-by-minivan6-2-550x358.jpg" alt="Northern Lights" class="tip-img">
                        <div class="tip-badge"><i class="ph-bold ph-map-pin"></i> Rovaniemi</div>
                    </div>
                    <div class="tip-body">
                        <h4 class="tip-title">The Ultimate Guide to Chasing the Northern Lights.</h4>
                        <p class="tip-desc">Learn how to maximize your chances of seeing the Aurora Borealis on a guided minivan tour across the Arctic wilderness.</p>
                        <a href="#" class="tip-link">Read More <i class="ph-bold ph-caret-right"></i></a>
                    </div>
                </div>

                <!-- Tip 3 -->
                <div class="tip-card">
                    <div class="tip-img-box">
                        <img src="images/offers/Traditional-Reindeer-Farm-Visit3-2-550x358.jpg" alt="Reindeer Farm" class="tip-img">
                        <div class="tip-badge"><i class="ph-bold ph-map-pin"></i> Levi, Lapland</div>
                    </div>
                    <div class="tip-body">
                        <h4 class="tip-title">Immerse Yourself in Sami Culture at a Traditional Reindeer Farm.</h4>
                        <p class="tip-desc">Get up close with Lapland's most iconic animals and experience a traditional sleigh ride through the snowy forests.</p>
                        <a href="#" class="tip-link">Read More <i class="ph-bold ph-caret-right"></i></a>
                    </div>
                </div>
                
                <!-- Tip 4 -->
                <div class="tip-card">
                    <div class="tip-img-box">
                        <img src="images/offers/Day-Trip-to-Santa-Village7-550x358.jpg" alt="Santa Village" class="tip-img">
                        <div class="tip-badge"><i class="ph-bold ph-map-pin"></i> Rovaniemi</div>
                    </div>
                    <div class="tip-body">
                        <h4 class="tip-title">A Magical Day Trip to Santa Claus Village.</h4>
                        <p class="tip-desc">Experience the joy of meeting Santa Claus and crossing the magical Arctic Circle in Rovaniemi.</p>
                        <a href="#" class="tip-link">Read More <i class="ph-bold ph-caret-right"></i></a>
                    </div>
                </div>

                <!-- Tip 5 -->
                <div class="tip-card">
                    <div class="tip-img-box">
                        <img src="images/citys/15-Kilometers-Self-Driving-Husky-Tour-in-Levi1-2-550x358.jpg" alt="Husky Tour" class="tip-img">
                        <div class="tip-badge"><i class="ph-bold ph-map-pin"></i> Levi, Lapland</div>
                    </div>
                    <div class="tip-body">
                        <h4 class="tip-title">Thrilling 15km Self-Driving Husky Safari.</h4>
                        <p class="tip-desc">Take the reins and drive your own team of eager huskies through the pristine snow-covered landscapes of Levi.</p>
                        <a href="#" class="tip-link">Read More <i class="ph-bold ph-caret-right"></i></a>
                    </div>
                </div>

                <!-- Tip 6 -->
                <div class="tip-card">
                    <div class="tip-img-box">
                        <img src="images/offers/Snow-Village-by-Snowmobile4-550x358.jpg" alt="Snow Village" class="tip-img">
                        <div class="tip-badge"><i class="ph-bold ph-map-pin"></i> Kittilä</div>
                    </div>
                    <div class="tip-body">
                        <h4 class="tip-title">Snowmobiling to the Magnificent Snow Village.</h4>
                        <p class="tip-desc">Embark on an exhilarating snowmobile journey to explore the stunning ice sculptures and rooms of the Snow Village.</p>
                        <a href="#" class="tip-link">Read More <i class="ph-bold ph-caret-right"></i></a>
                    </div>
                </div>
            </div>
            
