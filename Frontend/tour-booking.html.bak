    </header>
    <!-- Booking Page Top Banner -->
    <section class="booking-banner" style="background-color: #F8FAFC; padding: 3rem 0; margin-bottom: 2rem; border-radius: 0 0 40px 40px;">
        <div class="container" style="display: flex; align-items: center; justify-content: space-between;">
            <div>
                <div class="breadcrumb" style="font-size: 0.85rem; color: #64748B; margin-bottom: 0.5rem;">
                    <i class="ph-bold ph-house"></i> Home &bull; Tour Packages &bull; Tour Details &bull; Booking
                </div>
                <h1 style="font-size: 2.5rem; font-weight: 800; color: #0F172A; margin: 0;">Review your Booking</h1>
            </div>
        </div>
    </section>

    <!-- Booking Stepper -->
    <div class="container" style="margin-bottom: 3rem;">
        <div class="booking-stepper" style="display: flex; justify-content: space-between; align-items: center; max-width: 800px; margin: 0 auto; position: relative;">
            <div style="position: absolute; top: 15px; left: 10%; right: 10%; height: 2px; background: #E2E8F0; z-index: 1;"></div>
            
            <div class="step active" style="text-align: center; z-index: 2; position: relative;">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: #4F46E5; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 0.5rem auto; font-size: 0.9rem;">1</div>
                <div style="font-weight: 700; color: #4F46E5; font-size: 0.9rem;">Tour Review</div>
            </div>
            
            <div class="step" style="text-align: center; z-index: 2; position: relative;">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: #F1F5F9; border: 2px solid #CBD5E1; color: #64748B; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 0.5rem auto; font-size: 0.9rem;">2</div>
                <div style="font-weight: 600; color: #0F172A; font-size: 0.9rem;">Traveler Info</div>
            </div>
            
            <div class="step" style="text-align: center; z-index: 2; position: relative;">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: #F1F5F9; border: 2px solid #CBD5E1; color: #64748B; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 0.5rem auto; font-size: 0.9rem;">3</div>
                <div style="font-weight: 600; color: #0F172A; font-size: 0.9rem;">Make Payment</div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <section class="booking-content" style="padding-bottom: 5rem;">
        <div class="container">
            <div>
                
                <!-- Left Column: Details -->
                <div class="booking-left">
                    <h2 style="font-size: 1.5rem; font-weight: 800; color: #0F172A; margin-bottom: 1.5rem;">Tour Review</h2>
                    
                    <!-- Tour Review Card -->
                    <div class="booking-card" style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; display: flex; gap: 1.5rem;">
                        <img src="images/packages/tour_1.jpg" alt="Tour" style="width: 150px; height: 100px; object-fit: cover; border-radius: 8px;">
                        <div>
                            <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem;">Beautiful Finland With Lapland</h3>
                            <div style="color: #FBBF24; margin-bottom: 0.5rem; font-size: 0.9rem;">
                                <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                            </div>
                            <div style="display: flex; gap: 1rem; color: #64748B; font-size: 0.85rem;">
                                <span><i class="ph-fill ph-calendar-blank"></i> April 12-17</span>
                                <span><i class="ph-fill ph-bed"></i> 1 Room</span>
                                <span><i class="ph-fill ph-users"></i> 2 Guests</span>
                                <span><i class="ph-fill ph-map-pin"></i> From New York</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Flight Details Card -->
                    <div class="booking-card" style="border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 1.5rem; overflow: hidden;">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid #E2E8F0; background: #F8FAFC;">
                            <h4 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Flight Details</h4>
                            <a href="#" style="font-size: 0.85rem; color: #64748B; text-decoration: underline;">View details</a>
                        </div>
                        <div style="padding: 1.5rem;">
                            <!-- Flight 1 -->
                            <div style="margin-bottom: 1.5rem; border-bottom: 1px dashed #E2E8F0; padding-bottom: 1.5rem;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.85rem; font-weight: 600;">
                                    <span>New York - Finland</span>
                                    <span style="color: #64748B;">Date: 12 April 2026</span>
                                </div>
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <div style="width: 100px;">
                                        <div style="font-weight: 800; color: #F59E0B; font-size: 1.2rem; font-style: italic;">FINNAIR</div>
                                        <div style="font-size: 0.75rem; color: #64748B;">Finnair</div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-weight: 800; font-size: 1.1rem;">JFK</div>
                                        <div style="font-size: 0.85rem; color: #0F172A;">2:50 pm</div>
                                    </div>
                                    <div style="flex: 1; margin: 0 2rem; position: relative; text-align: center;">
                                        <div style="font-size: 0.75rem; color: #0F172A; font-weight: 600; margin-bottom: 0.25rem;">8hr 50min</div>
                                        <div style="height: 2px; background: #CBD5E1; width: 100%; position: relative;">
                                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; background: #4F46E5; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white;">
                                                <i class="ph-fill ph-airplane-tilt" style="font-size: 0.9rem;"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="font-weight: 800; font-size: 1.1rem;">HEL</div>
                                        <div style="font-size: 0.85rem; color: #0F172A;">7:35 am</div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Flight 2 -->
                            <div>
                                <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.85rem; font-weight: 600;">
                                    <span>Finland - New York</span>
                                    <span style="color: #64748B;">Date: 18 April 2026</span>
                                </div>
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <div style="width: 100px;">
                                        <div style="font-weight: 800; color: #F59E0B; font-size: 1.2rem; font-style: italic;">FINNAIR</div>
                                        <div style="font-size: 0.75rem; color: #64748B;">Finnair</div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-weight: 800; font-size: 1.1rem;">HEL</div>
                                        <div style="font-size: 0.85rem; color: #0F172A;">5:50 pm</div>
                                    </div>
                                    <div style="flex: 1; margin: 0 2rem; position: relative; text-align: center;">
                                        <div style="font-size: 0.75rem; color: #0F172A; font-weight: 600; margin-bottom: 0.25rem;">9hr 10min</div>
                                        <div style="height: 2px; background: #CBD5E1; width: 100%; position: relative;">
                                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; background: #4F46E5; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white;">
                                                <i class="ph-fill ph-airplane-tilt" style="font-size: 0.9rem; transform: scaleX(-1);"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="font-weight: 800; font-size: 1.1rem;">JFK</div>
                                        <div style="font-size: 0.85rem; color: #0F172A;">11:35 pm</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Hotel Details Card -->
                    <div class="booking-card" style="border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 1.5rem; overflow: hidden;">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid #E2E8F0; background: #F8FAFC;">
                            <h4 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Hotel Details</h4>
                            <a href="#" style="font-size: 0.85rem; color: #64748B; text-decoration: underline;">View details</a>
                        </div>
                        <div style="padding: 1.5rem;">
                            <!-- Hotel 1 -->
                            <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem; border-bottom: 1px dashed #E2E8F0; padding-bottom: 1.5rem;">
                                <div>
                                    <h5 style="margin: 0 0 0.25rem 0; font-weight: 700; font-size: 1rem;">Arctic TreeHouse Hotel</h5>
                                    <div style="font-size: 0.85rem; color: #64748B; margin-bottom: 0.5rem;">Room: Arctic GlassHouse</div>
                                    <div style="color: #FBBF24; font-size: 0.8rem;">
                                        <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-weight: 600; font-size: 0.9rem;">12 April 2026</div>
                                    <div style="color: #10B981; font-size: 0.85rem;">Breakfast Included</div>
                                </div>
                            </div>
                            
                            <!-- Hotel 2 -->
                            <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem; border-bottom: 1px dashed #E2E8F0; padding-bottom: 1.5rem;">
                                <div>
                                    <h5 style="margin: 0 0 0.25rem 0; font-weight: 700; font-size: 1rem;">Kakslauttanen Arctic Resort</h5>
                                    <div style="font-size: 0.85rem; color: #64748B; margin-bottom: 0.5rem;">Room: Glass Igloo</div>
                                    <div style="color: #FBBF24; font-size: 0.8rem;">
                                        <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-weight: 600; font-size: 0.9rem;">14 April 2026</div>
                                    <div style="color: #10B981; font-size: 0.85rem;">Breakfast Included</div>
                                </div>
                            </div>
                            
                            <!-- Hotel 3 -->
                            <div style="display: flex; justify-content: space-between;">
                                <div>
                                    <h5 style="margin: 0 0 0.25rem 0; font-weight: 700; font-size: 1rem;">Hotel Kamp Helsinki</h5>
                                    <div style="font-size: 0.85rem; color: #64748B; margin-bottom: 0.5rem;">Room: Deluxe Double</div>
                                    <div style="color: #FBBF24; font-size: 0.8rem;">
                                        <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star-half"></i>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-weight: 600; font-size: 0.9rem;">16 April 2026</div>
                                    <div style="color: #10B981; font-size: 0.85rem;">Breakfast Included</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Transfer Details Card -->
                    <div class="booking-card" style="border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 1.5rem; overflow: hidden;">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid #E2E8F0; background: #F8FAFC;">
                            <h4 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Transfer Details</h4>
                            <a href="#" style="font-size: 0.85rem; color: #64748B; text-decoration: underline;">View details</a>
                        </div>
                        <div style="padding: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                            <div style="font-weight: 700; font-size: 0.95rem;">Private Transfer</div>
                            <div style="font-size: 0.85rem; color: #64748B;">Vehicle type: Sedan - AC</div>
                            <div style="font-weight: 600; font-size: 0.9rem;">12 April 2026</div>
                        </div>
                    </div>
                    
                    <!-- Cancellation Policy Card -->
                    <div class="booking-card" style="border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 1.5rem; overflow: hidden;">
                        <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #E2E8F0; background: #F8FAFC;">
                            <h4 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Cancellation & Date change</h4>
                        </div>
                        <div style="padding: 1.5rem; font-size: 0.85rem; color: #475569; line-height: 1.6;">
                            <ul style="list-style: none; padding: 0; margin: 0 0 1rem 0;">
                                <li><strong>- 10 days:</strong> 100%</li>
                                <li><strong>- 10 to 15 days:</strong> 75% + Non Refundable Component</li>
                                <li><strong>- 15 to 30 days:</strong> 30% + Non Refundable Component</li>
                                <li><strong>- Hotel / Air:</strong> 100% in case of non-refundable ticket / Hotel Room</li>
                                <li><strong>- Cruise / Visa:</strong> On Actuals</li>
                            </ul>
                            <p style="margin: 0; color: #64748B;">All Prices are in USD and are subject to change without prior notice. In the case FIT flight inclusive package, the full amount of the flight will be payable at the time of booking.</p>
                        </div>
                    </div>
                    
                    <div style="text-align: right; margin-top: 2rem;">
                        <a href="tour-traveler.html" class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 8px; font-weight: 700; text-decoration: none; display: inline-block;">Next</a>
                    </div>
                    
                </div>
                
                <!-- Right Column: Summary -->
                <div class="booking-right">
                    
                    <!-- Price Summary Card -->
                    <div class="summary-card" style="border: 1px solid #E2E8F0; border-radius: 12px; margin-bottom: 1.5rem; overflow: hidden;">
                        <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #E2E8F0; background: #F8FAFC;">
                            <h4 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Price Summary</h4>
                        </div>
                        <div style="padding: 1.5rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.9rem;">
                                <span style="color: #64748B;">Base Price</span>
                                <span style="font-weight: 600;">&euro;1,660</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.9rem;">
                                <span style="color: #64748B; display: flex; align-items: center; gap: 0.5rem;">Total Discount <span style="background: #EF4444; color: white; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 700;">10% off</span></span>
                                <span style="font-weight: 600; color: #10B981;">-&euro;160</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem; font-size: 0.9rem; padding-bottom: 1.5rem; border-bottom: 1px solid #E2E8F0;">
                                <span style="color: #64748B;">Taxes & Fees</span>
                                <span style="font-weight: 600;">Included</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 800; font-size: 1.1rem;">Payable Now</span>
                                <span style="font-weight: 900; font-size: 1.5rem; color: #0F172A;">&euro;1,500</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Sign In Card -->
                    <div class="summary-card" style="border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden;">
                        <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #E2E8F0; background: #F8FAFC;">
                            <h4 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Sign In Now To Book An Online</h4>
                        </div>
                        <div style="padding: 1.5rem;">
                            <div style="margin-bottom: 1rem;">
                                <label style="display: block; font-size: 0.85rem; color: #64748B; margin-bottom: 0.5rem;">Email id</label>
                                <input type="email" placeholder="Enter your email" style="width: 100%; padding: 0.75rem 1rem; border: none; background: #F1F5F9; border-radius: 8px; font-size: 0.9rem; outline: none;">
                            </div>
                            <div style="margin-bottom: 1rem;">
                                <label style="display: block; font-size: 0.85rem; color: #64748B; margin-bottom: 0.5rem;">Mobile number</label>
                                <input type="tel" placeholder="Enter your mobile number" style="width: 100%; padding: 0.75rem 1rem; border: none; background: #F1F5F9; border-radius: 8px; font-size: 0.9rem; outline: none;">
                            </div>
                            
                            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
                                <input type="checkbox" id="hasAccount" style="accent-color: #4F46E5;">
                                <label for="hasAccount" style="font-size: 0.85rem; color: #64748B; cursor: pointer;">I Already Have Booking Account</label>
                            </div>
                            
                            <button class="btn btn-primary" style="width: 100%; padding: 0.75rem; border-radius: 8px; font-weight: 700; margin-bottom: 1.5rem;">Book as Guest</button>
                            
                            <div style="position: relative; text-align: center; margin-bottom: 1.5rem;">
                                <hr style="border: none; border-top: 1px solid #E2E8F0; position: absolute; width: 100%; top: 50%; transform: translateY(-50%); z-index: 1;">
                                <span style="background: white; padding: 0 10px; position: relative; z-index: 2; font-size: 0.75rem; color: #94A3B8;">Or via social media</span>
                            </div>
                            
                            <div style="display: flex; gap: 1rem;">
                                <button style="flex: 1; padding: 0.5rem; border-radius: 6px; border: none; background: #1877F2; color: white; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                                    <i class="ph-bold ph-facebook-logo"></i> Facebook
                                </button>
                                <button style="flex: 1; padding: 0.5rem; border-radius: 6px; border: none; background: #DB4437; color: white; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                                    <i class="ph-bold ph-google-logo"></i> Google
                                </button>
                            </div>
                        </div>
                    </div>
                    
                </div>
                
            </div>
        </div>
    </section>
