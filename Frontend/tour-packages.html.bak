<!-- Hero Section -->
<section class="tour-packages-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 class="hero-title">Tour Packages</h1>
        <p class="hero-breadcrumb">Home &gt; Tour Packages</p>
    </div>
</section>

<!-- Main Layout -->
<section class="container" style="padding-top: 4rem; padding-bottom: 5rem;">
    <div class="packages-layout">
        
        <!-- Left Sidebar: Filters -->
        <aside class="packages-sidebar">
            <div class="sidebar-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; display: flex; align-items: center; gap: 0.5rem;"><i class="ph-bold ph-faders"></i> Filter</h3>
                <button style="border: none; background: transparent; color: #64748B; cursor: pointer; font-size: 0.9rem;">Reset</button>
            </div>
            
            <!-- Destinations -->
            <div class="filter-section">
                <h4 class="filter-section-title">Destinations</h4>
                <div class="filter-accordion">
                    <div class="accordion-item open">
                        <div class="accordion-header">
                            <span><i class="ph-bold ph-caret-down"></i> Europe</span>
                            <span class="count">35</span>
                        </div>
                        <div class="accordion-body">
                            <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">France / Paris</span> <span class="cb-count">10</span></label>
                            <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Greece / Italy</span> <span class="cb-count">14</span></label>
                            <label class="custom-checkbox"><input type="checkbox" checked><span class="checkmark"></span> <span class="cb-text">London / England</span> <span class="cb-count">24</span></label>
                            <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Netherlands</span> <span class="cb-count">33</span></label>
                            <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Portugal</span> <span class="cb-count">15</span></label>
                            <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Germany</span> <span class="cb-count">17</span></label>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span><i class="ph-bold ph-caret-right"></i> Asia</span>
                            <span class="count">21</span>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span><i class="ph-bold ph-caret-right"></i> Africa</span>
                            <span class="count">7</span>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span><i class="ph-bold ph-caret-right"></i> North America</span>
                            <span class="count">11</span>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span><i class="ph-bold ph-caret-right"></i> Oceania</span>
                            <span class="count">4</span>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span><i class="ph-bold ph-caret-right"></i> Middle East</span>
                            <span class="count">9</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <hr class="filter-divider">
            
            <!-- Tour Category -->
            <div class="filter-section">
                <h4 class="filter-section-title">Tour Category</h4>
                <div class="category-pills">
                    <button class="pill-btn">Group tours</button>
                    <button class="pill-btn">Small Group</button>
                    <button class="pill-btn">Family</button>
                    <button class="pill-btn">Single Tours</button>
                    <button class="pill-btn">Private Tours</button>
                </div>
            </div>
            
            <hr class="filter-divider">
            
            <!-- Duration -->
            <div class="filter-section">
                <h4 class="filter-section-title">Duration</h4>
                <div class="filter-list">
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> 0-3 Days</label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> 3-5 Days</label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> 5-10 Days</label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> > 10 Days</label>
                </div>
            </div>
            
            <hr class="filter-divider">
            
            <!-- Pricing -->
            <div class="filter-section">
                <h4 class="filter-section-title">Pricing</h4>
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
                    <button style="background: #4F46E5; color: white; border: none; border-radius: 20px; padding: 4px 12px; font-size: 0.8rem;">Person</button>
                    <button style="background: transparent; color: #64748B; border: 1px solid #CBD5E1; border-radius: 20px; padding: 4px 12px; font-size: 0.8rem;">Group</button>
                </div>
                <div class="price-slider-mock">
                    <div class="slider-track">
                        <div class="slider-fill" style="left: 0; right: 20%;"></div>
                        <div class="slider-handle left" style="left: 0;"></div>
                        <div class="slider-handle right" style="right: 20%;"></div>
                    </div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #0F172A; font-weight: 600; margin-top: 0.5rem;">
                    <span>&euro;0</span>
                    <span>&euro;1,245</span>
                </div>
            </div>
            
            <hr class="filter-divider">
            
            <!-- Activities -->
            <div class="filter-section">
                <h4 class="filter-section-title">Activities</h4>
                <div class="filter-list">
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Jungle Trekking</span> <span class="cb-count">24</span></label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">River Rafting</span> <span class="cb-count">19</span></label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Camping</span> <span class="cb-count">43</span></label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Bungee Jumping</span> <span class="cb-count">21</span></label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Paragliding</span> <span class="cb-count">18</span></label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> <span class="cb-text">Sky Diving</span> <span class="cb-count">9</span></label>
                    <a href="#" style="color: #4F46E5; font-size: 0.85rem; text-decoration: none; margin-top: 0.5rem; display: inline-block;">+ show all 14</a>
                </div>
            </div>
            
            <hr class="filter-divider">
            
            <!-- Discount & Offer -->
            <div class="filter-section">
                <h4 class="filter-section-title">Discount & Offer</h4>
                <div class="filter-list">
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> Special Offer</label>
                    <label class="custom-checkbox"><input type="checkbox"><span class="checkmark"></span> Last Minutes Tour</label>
                </div>
            </div>
            
        </aside>
        
        <!-- Right Area: Tour Grid -->
        <main class="packages-results">
            
            <div class="results-header">
                <p style="font-size: 1.1rem; color: #0F172A; margin: 0;">We found <strong>24</strong> tour packages</p>
                <div style="display: flex; gap: 1rem; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; border: 1px solid #E2E8F0; padding: 0.5rem 1rem; border-radius: 6px; background: white;">
                        <span style="font-size: 0.9rem; color: #64748B;">Sort By :</span>
                        <select style="border: none; background: transparent; font-weight: 600; color: #0F172A; outline: none; cursor: pointer;">
                            <option>Default</option>
                            <option>Price (Low to High)</option>
                            <option>Price (High to Low)</option>
                        </select>
                    </div>
                    <div style="display: flex; gap: 0.25rem;">
                        <button style="border: 1px solid #E2E8F0; background: #F8FAFC; padding: 0.5rem; border-radius: 4px; color: #4F46E5; cursor: pointer;"><i class="ph-bold ph-squares-four" style="font-size: 1.2rem;"></i></button>
                        <button style="border: 1px solid #E2E8F0; background: #FFFFFF; padding: 0.5rem; border-radius: 4px; color: #94A3B8; cursor: pointer;"><i class="ph-bold ph-list" style="font-size: 1.2rem;"></i></button>
                    </div>
                </div>
            </div>
            
            <!-- Tour Cards Grid -->
            <div class="tours-grid packages-grid">                    
                <!-- Package 1 -->
                <div class="tour-card">
                    <div class="tour-img-box">
                        <img src="images/packages/65535_54274700516_8d0245d0c1_b_800_600_nofilter.jpg" alt="Helsinki City" class="tour-img" style="object-fit: cover;">
                        <div class="badge-top-left"><i class="ph-fill ph-heart"></i></div>
                        <div class="badge-stack-right">
                            <span class="tour-badge red-bg">Sale on!</span>
                            <span class="tour-badge yellow-bg text-dark">Best seller</span>
                        </div>
                    </div>
                    <div class="tour-body">
                        <div class="tour-rating">
                            <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                            <span class="rating-val">(5.0)</span>
                        </div>
                        <h4 class="tour-title">Helsinki City & Suomenlinna Tour</h4>
                        <div class="tour-meta">
                            <span class="meta-item"><i class="ph ph-map-pin"></i> Helsinki, Finland</span>
                            <span class="meta-item"><i class="ph ph-clock"></i> 7 Days</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #64748B; margin-bottom: 1.5rem; line-height: 1.5;">Explore the vibrant capital of Finland, including the historic sea fortress of Suomenlinna and bustling market squares.</p>
                        
                        <div class="tour-footer" style="flex-direction: column; align-items: stretch; gap: 1rem;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                                <div class="tour-price-box">
                                    <span class="price-label">Starting From</span>
                                    <div class="price-display">
                                        <span class="price-main">$280</span><span class="price-sub">/per person</span>
                                    </div>
                                    <div class="hotel-flight-tag">Hotel/Flight Included <i class="ph-bold ph-check"></i></div>
                                </div>
                                <a href="tour-details.html" class="btn btn-primary rounded-pill">View Tour</a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Package 2 -->
                <div class="tour-card">
                    <div class="tour-img-box">
                        <img src="images/packages/7111_13901216855_cca37b8607_b_800_600_nofilter.jpg" alt="Lakeland" class="tour-img" style="object-fit: cover;">
                        <div class="badge-top-left"><i class="ph ph-heart"></i></div>
                        <div class="badge-stack-right">
                            <span class="tour-badge red-bg">15% off</span>
                            <span class="tour-badge yellow-bg text-dark">Group tour</span>
                        </div>
                    </div>
                    <div class="tour-body">
                        <div class="tour-rating">
                            <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star-half"></i>
                            <span class="rating-val">(4.8)</span>
                        </div>
                        <h4 class="tour-title">Finnish Lakeland Summer Retreat</h4>
                        <div class="tour-meta">
                            <span class="meta-item"><i class="ph ph-map-pin"></i> Lakeland, Finland</span>
                            <span class="meta-item"><i class="ph ph-clock"></i> 5 Days</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #64748B; margin-bottom: 1.5rem; line-height: 1.5;">Experience the tranquility of thousands of lakes. Perfect for cabin life, sauna, and midnight sun fishing.</p>
                        
                        <div class="tour-footer" style="flex-direction: column; align-items: stretch; gap: 1rem;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                                <div class="tour-price-box">
                                    <span class="price-label">Starting From</span>
                                    <div class="price-display">
                                        <span class="price-main">$450</span><span class="price-sub">/per person</span>
                                    </div>
                                    <div class="hotel-flight-tag">Hotel/Flight Included <i class="ph-bold ph-check"></i></div>
                                </div>
                                <a href="tour-details.html" class="btn btn-primary rounded-pill">View Tour</a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Package 3 -->
                <div class="tour-card">
                    <div class="tour-img-box">
                        <img src="images/citys/1-Snowmobile-Reindeer-Husky-5-550x358.jpg" alt="Rovaniemi" class="tour-img" style="object-fit: cover;">
                        <div class="badge-top-left"><i class="ph-fill ph-heart"></i></div>
                        <div class="badge-stack-right">
                            <span class="tour-badge red-bg">10% off</span>
                            <span class="tour-badge yellow-bg text-dark">Best seller</span>
                        </div>
                    </div>
                    <div class="tour-body">
                        <div class="tour-rating">
                            <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star-half"></i>
                            <span class="rating-val">(4.7)</span>
                        </div>
                        <h4 class="tour-title">Rovaniemi Santa Claus Village</h4>
                        <div class="tour-meta">
                            <span class="meta-item"><i class="ph ph-map-pin"></i> Rovaniemi, Finland</span>
                            <span class="meta-item"><i class="ph ph-clock"></i> 4 Days</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #64748B; margin-bottom: 1.5rem; line-height: 1.5;">Meet Santa Claus year-round and cross the Arctic Circle in the beautiful snowy wilderness of Lapland.</p>
                        
                        <div class="tour-footer" style="flex-direction: column; align-items: stretch; gap: 1rem;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                                <div class="tour-price-box">
                                    <span class="price-label">Starting From</span>
                                    <div class="price-display">
                                        <span class="price-main">$350</span><span class="price-sub">/per person</span>
                                    </div>
                                    <div class="hotel-flight-tag">Hotel/Flight Included <i class="ph-bold ph-check"></i></div>
                                </div>
                                <a href="tour-details.html" class="btn btn-primary rounded-pill">View Tour</a>
                            </div>
                        </div>
                    </div>
                </div>     
            </div>
            
            <div style="text-align: center; margin-top: 3rem;">
                <button style="background: transparent; color: #4F46E5; border: 1px solid #4F46E5; padding: 0.8rem 2rem; border-radius: 30px; font-weight: 600; cursor: pointer; transition: all 0.3s;" onmouseover="this.style.background='#4F46E5'; this.style.color='#FFF';" onmouseout="this.style.background='transparent'; this.style.color='#4F46E5';">Load More</button>
            </div>
            
        </main>
    </div>
</section>

