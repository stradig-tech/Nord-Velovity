        </div>
    </div>
</section>

<!-- Hotels Section -->
<section class="hotels-section bg-light-blue" id="hotels" style="padding: 5rem 0;">
    <div class="tours-container">
        <h2 class="section-title text-center">Top Rated Hotels</h2>
        <div class="hotels-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 3rem;">
            
            <!-- Hotel Card 1 -->
            <div class="hotel-card bg-white" style="border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s ease;">
                <div style="height: 200px; background-image: url('images/packages/65535_54274700516_8d0245d0c1_b_800_600_nofilter.jpg'); background-size: cover; background-position: center;"></div>
                <div style="padding: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="color: #F59E0B; font-size: 0.9rem;"><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i></span>
                        <span style="font-size: 0.85rem; color: #64748B;">Resort</span>
                    </div>
                    <h4 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Arctic TreeHouse Hotel</h4>
                    <p style="font-size: 0.9rem; color: #64748B; margin-bottom: 1rem;"><i class="ph ph-map-pin"></i> Rovaniemi, Finland</p>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #E2E8F0; padding-top: 1rem;">
                        <div>
                            <span style="font-size: 1.25rem; font-weight: 700; color: #2563EB;">$350</span><span style="font-size: 0.85rem; color: #64748B;">/night</span>
                        </div>
                        <button class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Book Room</button>
                    </div>
                </div>
            </div>
            
            <!-- Hotel Card 2 -->
            <div class="hotel-card bg-white" style="border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s ease;">
                <div style="height: 200px; background-image: url('images/citys/1-Northern-Lights-Snowmobile-Levi-550x358.jpg'); background-size: cover; background-position: center;"></div>
                <div style="padding: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="color: #F59E0B; font-size: 0.9rem;"><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i></span>
                        <span style="font-size: 0.85rem; color: #64748B;">Luxury</span>
                    </div>
                    <h4 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Hotel Kämp</h4>
                    <p style="font-size: 0.9rem; color: #64748B; margin-bottom: 1rem;"><i class="ph ph-map-pin"></i> Helsinki, Finland</p>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #E2E8F0; padding-top: 1rem;">
                        <div>
                            <span style="font-size: 1.25rem; font-weight: 700; color: #2563EB;">$420</span><span style="font-size: 0.85rem; color: #64748B;">/night</span>
                        </div>
                        <button class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Book Room</button>
                    </div>
                </div>
            </div>

            <!-- Hotel Card 3 -->
            <div class="hotel-card bg-white" style="border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s ease;">
                <div style="height: 200px; background-image: url('images/citys/Pyha_Sunrise-550x358.jpg'); background-size: cover; background-position: center;"></div>
                <div style="padding: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="color: #F59E0B; font-size: 0.9rem;"><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i></span>
                        <span style="font-size: 0.85rem; color: #64748B;">Boutique</span>
                    </div>
                    <h4 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Järvisydän Resort</h4>
                    <p style="font-size: 0.9rem; color: #64748B; margin-bottom: 1rem;"><i class="ph ph-map-pin"></i> Rantasalmi, Finland</p>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #E2E8F0; padding-top: 1rem;">
                        <div>
                            <span style="font-size: 1.25rem; font-weight: 700; color: #2563EB;">$280</span><span style="font-size: 0.85rem; color: #64748B;">/night</span>
                        </div>
                        <button class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Book Room</button>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>

<!-- Transport Section -->
<section class="transport-section" id="transport" style="padding: 5rem 0;">
    <div class="tours-container">
        <h2 class="section-title text-center">Seamless Transport Options</h2>
        <p class="text-center" style="color: #64748B; max-width: 600px; margin: 0 auto 3rem auto;">Whether you need an airport transfer, a rental car for a road trip, or private chauffeur services, we have you covered.</p>
        
        <div class="transport-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
            
            <!-- Transport Card 1 -->
            <div class="transport-card" style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 2rem; text-align: center; transition: all 0.3s ease;">
                <div style="width: 70px; height: 70px; background: #EEF2FF; color: #2563EB; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; font-size: 2rem;">
                    <i class="ph-fill ph-car-profile"></i>
                </div>
                <h4 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Car Rental</h4>
                <p style="font-size: 0.9rem; color: #64748B; margin-bottom: 1.5rem;">Explore at your own pace with our wide selection of rental vehicles.</p>
                <div style="font-weight: 700; color: #2563EB; margin-bottom: 1.5rem;">From  / day</div>
                <button class="btn btn-primary" style="width: 100%;">View Cars</button>
            </div>
            
            <!-- Transport Card 2 -->
            <div class="transport-card" style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 2rem; text-align: center; transition: all 0.3s ease;">
                <div style="width: 70px; height: 70px; background: #EEF2FF; color: #2563EB; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; font-size: 2rem;">
                    <i class="ph-fill ph-taxi"></i>
                </div>
                <h4 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Airport Taxi</h4>
                <p style="font-size: 0.9rem; color: #64748B; margin-bottom: 1.5rem;">Fast and reliable transfers to and from major airports.</p>
                <div style="font-weight: 700; color: #2563EB; margin-bottom: 1.5rem;">Fixed Prices</div>
                <button class="btn btn-primary" style="width: 100%;">Book Taxi</button>
            </div>
            
            <!-- Transport Card 3 -->
            <div class="transport-card" style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 2rem; text-align: center; transition: all 0.3s ease;">
                <div style="width: 70px; height: 70px; background: #EEF2FF; color: #2563EB; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; font-size: 2rem;">
                    <i class="ph-fill ph-train"></i>
                </div>
                <h4 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Train Tickets</h4>
                <p style="font-size: 0.9rem; color: #64748B; margin-bottom: 1.5rem;">Scenic and comfortable railway journeys across Northern Europe.</p>
                <div style="font-weight: 700; color: #2563EB; margin-bottom: 1.5rem;">Book in Advance</div>
                <button class="btn btn-primary" style="width: 100%;">Search Routes</button>
            </div>

        </div>
    </div>
</section>

