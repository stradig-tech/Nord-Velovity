<!-- Hero Section for Tours -->
<section class="page-hero" style="background-image: linear-gradient(rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.4)), url('images/hero/Winter-landscape-19-2-scaled.jpg'); background-size: cover; background-position: center; padding: 120px 20px; text-align: center; color: white;">
    <h1 style="font-size: 3.5rem; font-weight: 700; margin-bottom: 1rem;">Explore the World</h1>
    <p style="font-size: 1.25rem; max-width: 600px; margin: 0 auto; opacity: 0.9;">Discover carefully curated tour packages, comfortable hotel stays, and seamless transport options for your next unforgettable journey.</p>
</section>

<!-- Tour Packages Section -->
<section class="tours-section" id="packages" style="padding-top: 5rem;">
    <div class="tours-container">
        <h2 class="section-title text-center">Featured Tour Packages</h2>
        <div class="tours-grid">
            <!-- Reuse tour cards from index.html structure -->
            <div class="tour-card">
                <div class="tour-img-box">
                    <img src="images/packages/31337_54406107252_f4ca19b35f_c_800_600_nofilter.jpg" alt="Lapland Northern Lights Escape" class="tour-img" style="object-fit: cover;">
                    <div class="badge-top-left"><i class="ph ph-heart"></i></div>
                    <div class="badge-stack-right">
                        <span class="tour-badge red-bg">Sale on!</span>
                        <span class="tour-badge yellow-bg text-dark">Group tour</span>
                    </div>
                </div>
                <div class="tour-body">
                    <div class="tour-rating">
                        <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                        <span class="rating-val">(4.9)</span>
                    </div>
                    <h4 class="tour-title">Lapland Northern Lights & Igloo Escape</h4>
                    <div class="tour-meta">
                        <span class="meta-item"><i class="ph ph-map-pin"></i> Rovaniemi, Finland</span>
                        <span class="meta-item"><i class="ph ph-clock"></i> 5 Days</span>
                    </div>
                    <div class="tour-footer">
                        <div class="tour-price-box">
                            <span class="price-label">Starting From</span>
                            <div class="price-display">
                                <span class="price-main"></span><span class="price-sub">/per person</span>
                            </div>
                        </div>
                        <a href="tour-details.html" class="btn btn-primary rounded-pill" style="text-decoration: none; display: inline-block;">View Tour</a>
                    </div>
                </div>
            </div>
            
            <div class="tour-card">
                <div class="tour-img-box">
                    <img src="images/packages/65535_54274700516_8d0245d0c1_b_800_600_nofilter.jpg" alt="Helsinki City Tour" class="tour-img" style="object-fit: cover;">
                    <div class="badge-top-left"><i class="ph ph-heart"></i></div>
                    <div class="badge-stack-right">
                        <span class="tour-badge red-bg">Up to 15% off</span>
                    </div>
                </div>
                <div class="tour-body">
                    <div class="tour-rating">
                        <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                        <span class="rating-val">(4.9)</span>
                    </div>
                    <h4 class="tour-title">Helsinki City & Suomenlinna Tour</h4>
                    <div class="tour-meta">
                        <span class="meta-item"><i class="ph ph-map-pin"></i> Helsinki, Finland</span>
                        <span class="meta-item"><i class="ph ph-clock"></i> 3 Days</span>
                    </div>
                    <div class="tour-footer">
                        <div class="tour-price-box">
                            <span class="price-label">Starting From</span>
                            <div class="price-display">
                                <span class="price-main"></span><span class="price-sub">/per person</span>
                            </div>
                        </div>
                        <a href="tour-details.html" class="btn btn-primary rounded-pill" style="text-decoration: none; display: inline-block;">View Tour</a>
                    </div>
                </div>
            </div>
            
            <div class="tour-card">
                <div class="tour-img-box">
                    <img src="images/packages/7111_13901216855_cca37b8607_b_800_600_nofilter.jpg" alt="Finnish Lakeland Retreat" class="tour-img" style="object-fit: cover;">
                    <div class="badge-top-left"><i class="ph ph-heart"></i></div>
                    <div class="badge-stack-right">
                        <span class="tour-badge green-bg">Featured</span>
                    </div>
                </div>
                <div class="tour-body">
                    <div class="tour-rating">
                        <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                        <span class="rating-val">(4.9)</span>
                    </div>
                    <h4 class="tour-title">Finnish Lakeland Summer Retreat</h4>
                    <div class="tour-meta">
                        <span class="meta-item"><i class="ph ph-map-pin"></i> Lakeland, Finland</span>
                        <span class="meta-item"><i class="ph ph-clock"></i> 7 Days</span>
                    </div>
                    <div class="tour-footer">
                        <div class="tour-price-box">
                            <span class="price-label">Starting From</span>
                            <div class="price-display">
                                <span class="price-main"></span><span class="price-sub">/per person</span>
                            </div>
                        </div>
