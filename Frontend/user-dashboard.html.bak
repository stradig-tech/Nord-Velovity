                <a href="contact.html" class="nav-link">Contact</a>             </nav>              <!-- Action Buttons -->             <div class="nav-actions logged-in-actions">
    <div class="notification-bell">
        <i class="ph-bold ph-bell"></i>
        <span class="notify-dot"></span>
        
        <!-- Notification Dropdown -->
        <div class="notification-dropdown">
            <div class="notif-header">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <h4>Notifications</h4>
                    <span class="notif-badge">4 new</span>
                </div>
                <a href="#" class="notif-clear">Clear all</a>
            </div>
            
            <div class="notif-body">
                <!-- Unread Notification -->
                <div class="notif-item unread">
                    <h5 class="notif-title">New! Booking tours from Helsinki &#x2744;&#xFE0F;</h5>
                    <p class="notif-desc">Find the flexible ticket on tours around the world. Start searching today</p>
                    <span class="notif-time">Wednesday</span>
                </div>
                
                <!-- Read Notification -->
                <div class="notif-item">
                    <h5 class="notif-title">Winter savings are here &#x1F976; save 30% or more on a tour</h5>
                    <span class="notif-time">15 Nov 2026</span>
                </div>
            </div>
            
            <div class="notif-footer">
                <a href="#">See all incoming activity</a>
            </div>
        </div>
    </div>
