<!DOCTYPE html> <html lang="en"> <head>     <meta charset="UTF-8">     <meta name="viewport" content="width=device-width, initial-scale=1.0">     <meta name="description" content="Nord Velocity - Your AI-powered travel planner">     <title>Nord Velocity | Home</title>     <link rel="stylesheet" href="style.css">          <!-- Google Fonts: Inter -->     <link rel="preconnect" href="https://fonts.googleapis.com">     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>     <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">     <!-- Google Fonts: Caveat (Script Font) -->     <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet">          <!-- Phosphor Icons -->     <script src="https://unpkg.com/@phosphor-icons/web"></script> </head> <body>     <header class="navbar">         <div class="navbar-container">             <!-- Logo -->             <a href="index.html" class="logo">                 <img src="images/brand/logo%20bg-transparent.png" alt="Nord Velocity" style="height: 90px; width: auto; object-fit: contain; transform: scale(1.2); transform-origin: left center;">             </a>              <!-- Navigation Links -->             <nav class="nav-links">                 <a href="index.html" class="nav-link active">Home</a>                                  <div class="dropdown">                     <a href="destination.html" class="nav-link dropdown-toggle" aria-expanded="false">Destination <i class="ph ph-caret-down"></i></a>                     <div class="megamenu">                         <div class="mega-sidebar bg-light-blue">                             <ul class="mega-nav-list">                                 <li><a href="#"><i class="ph-bold ph-caret-right text-muted"></i> Finland</a></li>                                 <li><a href="#"><i class="ph-bold ph-caret-right text-muted"></i> Scandinavia</a></li>                          