ckr.com/150/150/espoo,city/all?random=36" alt="Espoo"><span>Espoo</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/oulu,city/all?random=37" alt="Oulu"><span>Oulu</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/porvoo,finland/all?random=38" alt="Porvoo"><span>Porvoo</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/vaasa,finland/all?random=39" alt="Vaasa"><span>Vaasa</span></a>                             </div>                         </div>                         <div class="mega-promo" style="background-image: url('https://loremflickr.com/400/600/lapland,aurora/all?random=40');">                             <div class="mega-promo-overlay"></div>                             <div class="mega-promo-content">                                 <span class="promo-up-to">up to</span>                                 <h2 class="promo-discount-large">30<span class="percent">%</span></h2>                                 <h3 class="promo-sale">off<br>SALE</h3>                                 <p class="promo-desc">(winter offer for<br>Lapland & Helsinki upto<br>30%.)</p>                                 <a href="#" class="btn btn-primary">See Packages</a>                             </div>                         </div>                     </div>                 </div>                  <div class="dropdown">                     <a href="about.html" class="nav-link dropdown-toggle" aria-expanded="false">Company <i class="ph ph-caret-down"></i></a>                     <div class="megamenu">                         <div class="mega-sidebar bg-light-blue">                             <ul class="mega-nav-list">                                 <li><a href="about.html"><i class="ph-bold ph-caret-right text-muted"></i> About Us</a></li>                                 <li><a href="#"><i class="ph-bold ph-caret-right text-muted"></i> Our Services</a></li>                                 <li><a href="faq.html"><i class="ph-bold ph-caret-right text-muted"></i> FAQ</a></li>                                                                  <li><a href="contact.html"><i class="ph-bold ph-caret-right text-muted"></i> Contact Support</a></li>                                 <li><a href="blog.html"><i class="ph-bold ph-caret-right text-muted"></i> Blog</a></li>                             </ul>                             <a href="#" class="btn btn-outline btn-customize">View All Articles</a>                         </div>                         <div class="mega-content">                             <h4 class="mega-title text-center">Discover Nord Velocity</h4>                             <div class="mega-dest-grid">                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/office,team/all?random=80" alt="About Us"><span>About Us</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/travel,service/all?random=81" alt="Our Services"><span>Our Services</span></a>                                 <a href="faq.html" class="mega-dest-item"><img src="https://loremflickr.com/150/150/question,support/all?random=82" alt="FAQ"><span>FAQ</span></a>                                                                  <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/headset,support/all?random=84" alt="Contact Support"><span>Contact</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/writing,blog/all?random=85" alt="Blog"><span>Blog</span></a>                             </div>                         </div>                         <div class="mega-promo" style="background-image: url('https://loremflickr.com/400/600/laptop,coffee/all?random=1');">                             <div class="mega-promo-overlay"></div>                             <div class="mega-promo-content">                                 <h3 class="promo-sale" style="margin-bottom: 0.5rem; font-weight: 600;">2026 Travel<br>Report</h3>                                 <p class="promo-desc" style="margin-bottom: 1.5rem;">Discover the emerging trends shaping the future of global tourism.</p>                                 <a href="#" class="btn btn-primary">Read Now</a>                             </div>                         </div>                     </div>                 </div>                  <div class="dropdown">                     <a href="tour.html" class="nav-link dropdown-toggle" aria-expanded="false">Tour <i class="ph ph-caret-down"></i></a>                     <div class="megamenu">                         <div class="mega-sidebar bg-light-blue">                             <ul class="mega-nav-list">                                 <li><a href="tour-packages.html"><i class="ph-bold ph-caret-right text-muted"></i> Tour Package</a></li>                                 <li><a href="#"><i class="ph-bold ph-caret-right text-muted"></i> Hotel</a></li>                             </ul>                             <a href="#" class="btn btn-outline btn-customize">Plan with AI</a>                         </div>                         <div class="mega-content">                             <h4 class="mega-title text-center">Featured Tour Categories</h4>                             <div class="mega-dest-grid">                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/nature,travel/all?random=1" alt="Luxury"><span>Luxury</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/nature,travel/all?random=2" alt="Adventure"><span>Adventure</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/nature,travel/all?random=3" alt="Family"><span>Family</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/nature,travel/all?random=4" alt="Honeymoon"><span>Honeymoon</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/nature,travel/all?random=5" alt="Cultural"><span>Cultural</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/lapland,aurora/all?random=50" alt="Northern Lights"><span>Northern Lights</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/icebreaker,ship/all?random=51" alt="Icebreaker"><span>Icebreaker</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/finland,lake/all?random=52" alt="Lakeland"><span>Lakeland</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/skiing,snow/all?random=53" alt="Winter Sports"><span>Winter Sports</span></a>                                 <a href="#" class="mega-dest-item"><img src="https://loremflickr.com/150/150/nature,travel/all?random=10" alt="City Breaks"><span>City Breaks</span></a>                             </div>                         </div>                         <div class="mega-promo" style="background-image: url('https://loremflickr.com/400/600/finland,husky/all?random=60');">                             <div class="mega-promo-overlay"></div>                             <div class="mega-promo-content">                                 <h3 class="promo-sale" style="font-weight: 600; margin-bottom: 0;">15% OFF</h3>                                 <p class="promo-desc" style="font-size: 1.1rem; margin-bottom: 1.5rem;">Winter<br>Packages</p>                                 <a href="#" class="btn b