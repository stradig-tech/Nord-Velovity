    </header>
    <section class="dashboard" style="padding: 3rem 0; background-color: #f8fafc; min-height: 80vh;">
        <div class="container" style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 280px 1fr; gap: 2rem;">
            
            <!-- Left Sidebar -->
            <div class="dashboard-sidebar form-card">
                <div class="sidebar-profile-header">
                    <div class="profile-pic-wrapper">
                        <img src="images/team/testimonial-author-img4.png" alt="Jacqueline Miller">
                        <button class="edit-pic-btn"><i class="ph ph-pencil-simple"></i></button>
                    </div>
                    <h3>Jacqueline Miller</h3>
                    <p>hello@gmail.com</p>
                </div>
                
                <ul class="sidebar-nav">
                    <li><a href="user-dashboard.html" class="active"><i class="ph ph-user"></i> My Profile</a></li>
                    <li><a href="my-bookings.html"><i class="ph ph-bookmark-simple"></i> My Bookings</a></li>
                    <li><a href="payment-details.html"><i class="ph ph-credit-card"></i> Payment Details</a></li>
                    <li><a href="my-wishlist.html"><i class="ph ph-heart"></i> Wishlist</a></li>
                    <li><a href="settings.html"><i class="ph ph-gear"></i> Settings</a></li>
                    
                    <li class="sign-out"><a href="#"><i class="ph-bold ph-sign-out"></i> Sign Out</a></li>
                </ul>
            </div>
            
            <!-- Main Content -->
            <div class="dashboard-main-content">
                
                <!-- Complete Your Profile Progress -->
                <div class="form-card profile-progress-card">
                    <div class="progress-header">
                        <h4>Complete Your Profile</h4>
                        <span class="progress-percent">85%</span>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill" style="width: 85%;"></div>
                    </div>
                    <p class="progress-desc">Get the best out of booking by adding the remaining details!</p>
                    
                    <div class="progress-checklist">
                        <div class="check-item verified"><i class="ph-fill ph-check-circle"></i> Verified Email</div>
                        <div class="check-item verified"><i class="ph-fill ph-check-circle"></i> Verified Mobile Number</div>
                        <div class="check-item pending"><i class="ph-fill ph-info"></i> Complete Basic Info</div>
                    </div>
                </div>

                <!-- Personal Information -->
                <div class="form-card">
                    <h3 class="form-card-title">Personal Information</h3>
                    
                    <div class="upload-photo-row">
                        <p>Upload your profile photo<span class="req">*</span></p>
                        <div class="upload-photo-actions">
                            <img src="images/team/testimonial-author-img4.png" alt="Profile">
                            <button class="btn btn-light-blue">Change</button>
                        </div>
                    </div>
                    
                    <form class="dashboard-form">
                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Full Name<span class="req">*</span></label>
                                <input type="text" value="Jacqueline Miller">
                            </div>
                            <div class="form-group">
                                <label>Email address<span class="req">*</span></label>
                                <input type="email" value="hello@gmail.com">
                            </div>
                        </div>
                        
                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Mobile number<span class="req">*</span></label>
                                <input type="text" value="222 555 666">
                            </div>
                            <div class="form-group">
                                <label>Nationality<span class="req">*</span></label>
                                <select>
                                    <option>Paris</option>
                                    <option>USA</option>
                                    <option>UK</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-row-2">
                            <div class="form-group">
                                <label>Date of Birth<span class="req">*</span></label>
                                <input type="text" value="29 Aug 1996">
                            </div>
                            <div class="form-group">
                                <label>Select Gender<span class="req">*</span></label>
                                <div class="radio-group-inline">
                                    <label class="radio-label"><input type="radio" name="gender" checked> Male</label>
                                    <label class="radio-label"><input type="radio" name="gender"> Female</label>
                                    <label class="radio-label"><input type="radio" name="gender"> Others</label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label>Address</label>
                            <textarea rows="3">2119 N Division Ave, New Hampshire, York, United States</textarea>
                        </div>
                        
                        <div class="form-actions-right">
                            <button type="button" class="btn btn-primary-solid">Save Changes</button>
                        </div>
                    </form>
                </div>
                
                <!-- Update Email -->
                <div class="form-card">
                    <h3 class="form-card-title">Update email</h3>
                    <p class="form-card-desc">Your current email address is <a href="#">example@gmail.com</a></p>
                    
                    <form class="dashboard-form" style="margin-top: 1.5rem;">
                        <div class="form-group">
                            <label>Enter your new email id<span class="req">*</span></label>
                            <input type="email" placeholder="Enter your email id">
                        </div>
                        <div class="form-actions-right">
                            <button type="button" class="btn btn-primary-solid">Save Email</button>
                        </div>
                    </form>
                </div>
                
                <!-- Update Password -->
                <div class="form-card">
                    <h3 class="form-card-title">Update Password</h3>
                    <p class="form-card-desc">Your current email address is <a href="#">example@gmail.com</a></p>
                    
                    <form class="dashboard-form" style="margin-top: 1.5rem;">
                        <div class="form-group">
                            <label>Current password</label>
                            <input type="password" placeholder="Enter current password">
                        </div>
                        <div class="form-group pwd-group">
                            <label>Enter new password</label>
                            <div class="pwd-input-wrapper">
                                <input type="password" placeholder="Enter new password">
                                <i class="ph ph-eye-slash pwd-toggle"></i>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Confirm new password</label>
                            <input type="password" placeholder="Confirm new password">
                        </div>
                        <div class="form-actions-right">
                            <button type="button" class="btn btn-primary-solid">Change Password</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </section>
